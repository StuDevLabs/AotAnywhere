<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- HelloLib is its own project; keep it out of this project's implicit
         globs (CI publishes both from the shared test/ tree). The local
         obj/bin also need explicit excludes: CI and local runs relocate
         BaseIntermediateOutputPath, which silently un-excludes ./obj, and a
         stale AssemblyInfo.cs in there fails the build with CS0579. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);HelloLib/**;HardeningCheck/**;obj/**;bin/**</DefaultItemExcludes>
    <!-- net10.0 is the package's supported floor (the oldest in-support
         .NET). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- win-arm64 publishes as the newest .NET (net11.0) so CI exercises the
         newest Windows link.rsp shape (extra static libs, /MERGE, /STACK,
         /CETCOMPAT, Synchronization.lib) and runtime objects (arm64 CFG
         dispatch) through the link shim, while win-x64 keeps covering the
         net10.0 floor. Bump on each new .NET release. -->
    <TargetFramework Condition="'$(RuntimeIdentifier)' == 'win-arm64'">net11.0</TargetFramework>
    <PublishAot>true</PublishAot>

    <!-- Selftest publishes (see Program.cs) exercise real ICU, zlib and
         OpenSSL at run time; the SELFTEST define keeps that code out of the
         default matrix binaries. -->
    <DefineConstants Condition="'$(AotAnywhereSelfTest)' == 'true'">$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Import Project="../src/StuDev.AotAnywhere.targets" />
</Project>
